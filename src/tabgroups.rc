#include <windows.h>
#include "resource.h"

#define VER_FILEVERSION             0,1,3,0
#define VER_FILEVERSION_STR         "0.1.3.0\0"

1 VERSIONINFO
FILEVERSION     VER_FILEVERSION
PRODUCTVERSION  VER_FILEVERSION
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0
FILEOS          VOS__WINDOWS32
FILETYPE        VFT_DLL
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "TabGroups plugin authors\0"
            VALUE "FileDescription",  "TabGroups - tab group organizer for Notepad++ (private beta)\0"
            VALUE "FileVersion",      VER_FILEVERSION_STR
            VALUE "InternalName",     "TabGroups\0"
            VALUE "LegalCopyright",   "Copyright (C) 2026 TabGroups plugin authors. GPL v3 or later.\0"
            VALUE "OriginalFilename", "TabGroups.dll\0"
            VALUE "ProductName",      "TabGroups for Notepad++\0"
            VALUE "ProductVersion",   VER_FILEVERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

IDD_TABGROUPS_DLG DIALOGEX 0, 0, 190, 220
STYLE DS_SETFONT | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_TOOLWINDOW | WS_EX_WINDOWEDGE
CAPTION "Tab Groups"
FONT 8, "MS Shell Dlg", 0, 0, 0x0
BEGIN
    DEFPUSHBUTTON   "&New group", IDC_BTN_NEWGRP, 4, 4, 56, 14
    PUSHBUTTON      "&Assign tab", IDC_BTN_ASSIGN, 64, 4, 56, 14
    PUSHBUTTON      "&Save", IDC_BTN_SAVE, 124, 4, 56, 14
    CONTROL         "", IDC_TREE, "SysTreeView32", WS_BORDER | WS_TABSTOP | TVS_HASBUTTONS | TVS_LINESATROOT | TVS_HASLINES | TVS_SHOWSELALWAYS, 4, 22, 182, 178
    LTEXT           "", IDC_STATUS, 4, 202, 182, 14, SS_NOPREFIX
END

IDD_INPUT DIALOGEX 0, 0, 220, 62
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "TabGroups"
FONT 8, "MS Shell Dlg", 0, 0, 0x0
BEGIN
    LTEXT           "", IDC_PROMPT, 7, 7, 206, 8
    EDITTEXT        IDC_TEXT, 7, 18, 206, 13, ES_AUTOHSCROLL
    DEFPUSHBUTTON   "OK", IDOK, 108, 40, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 163, 40, 50, 14
END

IDD_ASSIGN DIALOGEX 0, 0, 200, 150
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Assign tab to group"
FONT 8, "MS Shell Dlg", 0, 0, 0x0
BEGIN
    LTEXT           "Choose a group for the current tab:", IDC_PROMPT, 7, 7, 186, 8
    LISTBOX         IDC_LIST, 7, 18, 186, 100, LBS_NOTIFY | WS_VSCROLL | WS_BORDER | WS_TABSTOP
    DEFPUSHBUTTON   "OK", IDOK, 78, 128, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 133, 128, 50, 14
END
